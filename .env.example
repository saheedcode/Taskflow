# Copy this to .env.local and fill in real values.

# Base URL of the deployed app, used to build absolute URLs in metadata
# (OpenGraph tags, etc). Falls back to http://localhost:3000 if unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base URL of the TaskFlow backend. Read by lib/apiClient.js on every
# request — never hardcode this at a call site.
#   Local:  http://localhost:5000
#   Live:   https://taskflow-backend-s3k9.onrender.com
# Note: the live URL is on a free Render instance that spins down when
# idle — the first request after inactivity can take 30-60s. apiClient.js
# uses a 65s timeout to account for this; don't lower it.
NEXT_PUBLIC_API_URL=http://localhost:5000
